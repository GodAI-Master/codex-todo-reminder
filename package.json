{
  "name": "codex-todo-reminder",
  "version": "0.1.1",
  "description": "Standalone local todo reminders embedded in Codex Desktop",
  "type": "module",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GodAI-Master/codex-todo-reminder.git"
  },
  "homepage": "https://github.com/GodAI-Master/codex-todo-reminder#readme",
  "bugs": "https://github.com/GodAI-Master/codex-todo-reminder/issues",
  "engines": {
    "node": ">=22.16"
  },
  "bin": {
    "todoctl": "./scripts/todoctl.mjs"
  },
  "scripts": {
    "dev": "tsx watch server/main.ts",
    "dev:web": "vite",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json && node scripts/copy-server-assets.mjs",
    "build": "npm run build:web && npm run build:server",
    "start": "node dist/server/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "todoctl": "node scripts/todoctl.mjs",
    "codex:inject": "node scripts/codex-injector.mjs --watch",
    "smoke:coexistence": "node scripts/diagnose-sidebar-stability.mjs --port 9231 --duration 5000 && node scripts/smoke-panel-coexistence.mjs --port 9231",
    "install:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-windows.ps1",
    "uninstall:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall-windows.ps1"
  },
  "dependencies": {
    "@fastify/static": "10.1.2",
    "fastify": "5.11.2",
    "node-notifier": "10.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rrule": "2.8.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/jsdom": "21.1.7",
    "@types/node": "26.1.2",
    "@types/node-notifier": "8.0.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "26.1.0",
    "playwright": "1.62.1",
    "tsx": "4.23.5",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
